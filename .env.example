# --- inference (local tier) ---
LOCAL_BASE_URL=http://172.16.251.196:8000/v1
LOCAL_API_KEY=                 # bearer for vLLM; blank = no auth header
LOCAL_MODEL=                   # blank = first id from /v1/models
LOCAL_ENABLE_THINKING=0        # qwen3 reasoning off for generation

# --- paid lane (pro-plan jobs only; off until key + SPILL_ENABLED=1) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium        # low|medium|high; main cost lever
SPILL_ENABLED=0
SPILL_QUEUE_DEPTH=20           # spill when local queue deeper than this
DAILY_USD_CAP=5

# --- github app ---
GH_APP_ID=
GH_INSTALLATION_ID=            # fallback for manual enqueue; webhooks carry their own
GH_APP_PRIVATE_KEY_PATH=./docbot.private-key.pem
GH_WEBHOOK_SECRET=             # must match the App's webhook secret
WEBHOOK_BIND=0.0.0.0
WEBHOOK_PORT=8787
DOCS_BRANCH=docs/auto

# --- worker ---
QUEUE_PATH=./state/queue.sqlite
WORK_DIR=./work
LOG_DIR=./state
POLL_SECONDS=15
MAX_REPO_BYTES=40000000
MAX_FILES=3000
MAX_FILE_BYTES=200000
